@page
@model FinalProject.Areas.Identity.Pages.Account.ForgotPasswordModel

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 w-100" style="max-width: 500px;">
        <h2 class="text-center mb-4" style="color: #0099CC;">Forgot Password</h2>

        <form method="post">
            <div class="form-group mb-3">
                <label for="UserName" style="color: black;">Email</label>
                <input type="text" class="form-control" id="UserName" name="UserName" value="@Model.UserName" required style="color: black;" />
            </div>
            <div class="form-group mb-3">
                <label for="MobilePhone" style="color: black;">Mobile Phone</label>
                <input type="text" class="form-control" id="MobilePhone" name="MobilePhone" value="@Model.MobilePhone" required style="color: black;" />
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" style="color: black;">@Model.ErrorMessage</div>
            }

            <!-- Buttons: Go Back and Submit -->
            <div class="d-flex justify-content-between mt-4">
                <!-- Go Back Button -->
                <button id="go-back" type="button" class="btn btn-outline-secondary" onclick="window.history.back();">Go Back</button>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>
