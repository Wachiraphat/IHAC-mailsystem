@page
@model FinalProject.Areas.Identity.Pages.Account.ViewProfileModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .profile-container {
            margin-top: 80px;
        }

        .card {
            width: 100%;
            max-width: 600px;
            margin: auto;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .card-body {
            padding: 30px;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: #01579b;
            text-align: center;
        }

        p {
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .go-back-btn {
            margin-top: 20px;
            display: flex;
            justify-content: center;
        }

            .go-back-btn button {
                font-size: 1rem;
                padding: 10px 20px;
                border-radius: 5px;
            }

            .go-back-btn .btn-secondary {
                background-color: #039be5;
                border-color: #039be5;
            }

                .go-back-btn .btn-secondary:hover {
                    background-color: #0277bd;
                    border-color: #0277bd;
                }
    </style>
</head>
<body>
    <div class="container profile-container">
        <div class="d-flex justify-content-center">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title" style="color: #0099CC">Profile</h5>

                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>First Name:</strong> @Model.FirstName</p>
                    <p><strong>Last Name:</strong> @Model.LastName</p>
                    <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>

                    <div class="go-back-btn">
                        <button class="btn btn-secondary" onclick="window.history.back();">Go Back</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>