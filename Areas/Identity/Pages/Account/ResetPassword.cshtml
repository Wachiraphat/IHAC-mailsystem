@page
@model FinalProject.Areas.Identity.Pages.Account.ResetPasswordModel

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 w-100" style="max-width: 500px;">
        <h2 class="text-center mb-4" style="color: #0099CC;">Reset Password</h2>

        <form method="post">
            <!-- แสดงข้อผิดพลาดของการตรวจสอบ Model -->
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <!-- If there are model errors, display them with HTML breaks for line separation -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Html.Raw(Model.ErrorMessage)
                </div>
            }

            <div class="form-group mb-3">
                <label for="NewPassword" style="color: black;">New Password</label>
                <input type="password" class="form-control" id="NewPassword" name="NewPassword" required style="color: black;" />
            </div>

            <div class="form-group mb-3">
                <label for="ConfirmPassword" style="color: black;">Confirm Password</label>
                <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required style="color: black;" />
            </div>

            <div class="d-flex justify-content-between mt-4">
                <!-- Go Back Button -->
                <button id="go-back" type="button" class="btn btn-outline-secondary" onclick="window.history.back();">Go Back</button>

                <!-- Reset Password Button -->
                <button type="submit" class="btn btn-primary">Reset Password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            window.onload = function () {
                alert('@TempData["SuccessMessage"]');
            }
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            window.onload = function () {
                alert('@TempData["ErrorMessage"]');
            }
        </script>
    }
}
